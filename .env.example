# 蒲公英分发平台密钥
# 获取路径：登录蒲公英 → 右上角头像 → 账户设置 → API 信息
PGYER_API_KEY=
PGYER_USER_KEY=

# App Store Connect API Key(给 fastlane sync_release_notes 用)
# 获取路径:https://appstoreconnect.apple.com/access/integrations/api
# 生成 .p8 后只能下载一次,务必妥善保管(本项目放在 ~/keys/AuthKey_<KeyID>.p8)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
