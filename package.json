{
  "name": "kkcode-community",
  "version": "1.0.3",
  "private": true,
  "description": "OpenCode mobile remote client — community-maintained LAN-only edition",
  "main": "expo-router/entry",
  "license": "AGPL-3.0",
  "author": {
    "name": "junbaor"
  },
  "homepage": "https://github.com/kkcode-app/kkcode",
  "repository": {
    "type": "git",
    "url": "https://github.com/kkcode-app/kkcode.git"
  },
  "bugs": {
    "url": "https://github.com/kkcode-app/kkcode/issues"
  },
  "keywords": [
    "opencode",
    "react-native",
    "expo",
    "ios",
    "android",
    "ai",
    "chat"
  ],
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@lobehub/icons-rn": "^2.12.0",
    "@opencode-ai/sdk": "^1.17.4",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/slider": "5.2.1",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~56.0.11",
    "expo-asset": "~56.0.21",
    "expo-build-properties": "^56.0.18",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.0",
    "expo-file-system": "~56.0.8",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.18",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-local-authentication": "^56.0.4",
    "expo-localization": "^56.0.6",
    "expo-router": "~56.2.10",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.0",
    "expo-status-bar": "~56.0.4",
    "i18next": "^26.3.1",
    "punycode": "^2.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-keyboard-controller": "1.22.4",
    "react-native-legal": "^1.6.5",
    "react-native-markdown-display": "^7.0.2",
    "react-native-network-logger": "^3.0.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.12.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/node": "^25.9.3",
    "@types/react": "~19.2.18",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "lint-staged": "^15.4.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.2.8",
    "simple-git-hooks": "^2.11.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cd android && ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "android:install:debug": "cd android && ./gradlew installDebug",
    "android:clean": "cd android && ./gradlew clean",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "tsx --import ./test/register-mocks.ts test/run.ts",
    "test:integration": "tsx --import ./test/register-mocks.ts test/run-integration.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "hooks:install": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "export PATH=\"$PWD/node_modules/.bin:$PATH\" && lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=999",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
